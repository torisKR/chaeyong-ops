    "calibrate": "node calibrate.mjs",
    "upskill": "node upskill.mjs",
    "add": "node add-entry.mjs",
    "reposts": "node detect-reposts.mjs",
    "digest": "node weekly-digest.mjs",
    "freshness": "node check-table-freshness.mjs",
    "jd-archive": "node check-jd-archive.mjs",
    "rejection-latency": "node rejection-latency.mjs",
    "invite-match": "node invite-match.mjs",
    "paste-reply": "node paste-reply.mjs",
    "gemini:eval": "node gemini-eval.mjs",
    "ollama:eval": "node ollama-eval.mjs",
    "openai:eval": "node openai-eval.mjs",
    "openai:tailor": "node openai-tailor.mjs",
    "eval:golden": "node eval-golden.mjs",
    "star": "node match-star.mjs",
    "archive": "node archive-posting.mjs",
    "prepare:application": "node prepare-application.mjs",
    "application:init": "node application-artifacts.mjs --init",
